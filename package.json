{
  "name": "documentation",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/npm/documentation.git"
  },
  "private": true,
  "scripts": {
    "build": "doc-kit generate",
    "develop": "node scripts/develop.mjs",
    "clean": "node scripts/clean.mjs",
    "serve": "node scripts/serve.mjs",
    "lint": "eslint \"**/*.{js,mjs,jsx,mdx}\"",
    "postlint": "template-oss-check",
    "template-oss-apply": "template-oss-apply --force",
    "lintfix": "npm run eslint -- --fix",
    "test": "echo \"There are no tests; the site is checked by 'npm run lint'\"",
    "posttest": "npm run lint",
    "test-all": "npm run test --workspaces --include-workspace-root --if-present",
    "lint-all": "npm run lint --workspaces --include-workspace-root --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "eslint": "eslint \"**/*.{js,cjs,ts,mjs,jsx,tsx}\""
  },
  "workspaces": [
    "cli/"
  ],
  "dependencies": {
    "@doc-kit/cli": "^1.0.4",
    "@doc-kit/core": "^1.2.1",
    "@doc-kit/generator-react": "^0.4.0",
    "@orama/orama": "^3.1.18",
    "@primer/octicons-react": "^19.8.0",
    "github-slugger": "^2.0.0",
    "preact": "^10.29.7",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@github/prettier-config": "^0.0.6",
    "@npmcli/eslint-config": "^6.0.0",
    "@npmcli/template-oss": "5.1.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-react-app": "^7.0.1",
    "eslint-import-resolver-typescript": "^4.2.2",
    "eslint-mdx": "^3.1.3",
    "eslint-plugin-github": "^6.0.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-mdx": "^3.1.3",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "eslint-plugin-promise": "^7.0.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^7.0.0",
    "prettier": "^3.1.1"
  },
  "author": "GitHub Inc.",
  "engines": {
    "node": ">=22.12.0 <26"
  },
  "templateOSS": {
    "//@npmcli/template-oss": "This file is partially managed by @npmcli/template-oss. Edits may be overwritten.",
    "allowPaths": [
      "cli-cache.json"
    ],
    "content": "./scripts/template-oss",
    "dependabotInterval": "weekly",
    "updateNpm": false,
    "version": "5.1.0"
  }
}
